{
  "manifest_version": 3,
  "name": "Alice AI — English Overlay",
  "short_name": "Alice EN",
  "version": "1.0.0",
  "description": "Full English experience for alice.yandex.ru: translated UI, auto-English replies, mode bar (Auto/Expert/Draw/Deals/Math), EN prompt chips, copy & translate, upsell hiding. Works with Alice's free anonymous access — no login needed.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://alice.yandex.ru/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://alice.yandex.ru/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alice AI — English Overlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
